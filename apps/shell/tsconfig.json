{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@mf/contracts": ["../../packages/shared/contracts/src/index.ts"],
      "@mf/auth": ["../../packages/shared/auth/src/index.ts"],
      "@mf/events": ["../../packages/shared/events/src/index.ts"]
    }
  },
  "include": ["src", "../../packages/shared/**/*.ts"]
}
